# TNSI Platform Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# =============================================================================
# CLERK AUTHENTICATION
# =============================================================================
# Get these from your Clerk Dashboard: https://dashboard.clerk.com
# Development instance: https://dashboard.clerk.com/apps (select dev instance)
# Production instance: https://dashboard.clerk.com/apps (select prod instance)

# Public key - safe to expose to client
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Secret key - NEVER expose to client, server-side only
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Webhook secret - used to verify Clerk webhook signatures
# Get this from Clerk Dashboard > Webhooks > Signing Secret
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Clerk URLs (customize if needed)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Optional: Custom Clerk API URL (default: https://api.clerk.com)
# CLERK_API_URL=https://api.clerk.com

# =============================================================================
# DATABASE (NEON POSTGRESQL)
# =============================================================================
# Get from Neon Console: https://console.neon.tech
# Format: postgresql://user:password@host/database?sslmode=require

# For local development with Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tnsi_dev?sslmode=disable

# For Neon (production/staging):
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/tnsi?sslmode=require

# Optional: Unpooled connection for migrations
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/tnsi?sslmode=require

# =============================================================================
# SANITY CMS
# =============================================================================
# Get from Sanity Dashboard: https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=hookrbdv
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Read token for private content/drafts (server-side only)
SANITY_API_READ_TOKEN=skri_your_read_token_here

# Webhook secret - used to verify Sanity practice-sync webhook signatures.
# Get this from Sanity Dashboard > API > Webhooks > (webhook) > Secret.
# Required for POST /api/webhooks/sanity — see apps/web/src/app/api/webhooks/sanity/README.md.
SANITY_WEBHOOK_SECRET=

# =============================================================================
# FLOWI (CRM — newsletter signup → lead)
# =============================================================================
# Server-side only. A GoHighLevel Private Integration token (or OAuth access
# token) scoped to the TNSI location, generated from within the Flowi/GHL
# account (Settings > Private Integrations, or a Marketplace app install).
# Required for POST /api/newsletter to reach Flowi — see packages/integrations/src/flowi.ts.
FLOWI_API_KEY=

# The Flowi/GHL location (sub-account) id the newsletter contact is created in.
FLOWI_LOCATION_ID=

# =============================================================================
# STRIPE PAYMENTS
# =============================================================================
# Get from Stripe Dashboard: https://dashboard.stripe.com
# Server-side only — checkout uses Stripe's hosted Checkout page, so no
# publishable key / Stripe.js is needed in the client bundle at all.
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# From Stripe Dashboard > Developers > Webhooks > (endpoint) > Signing secret.
# Required for POST /api/webhooks/stripe — see apps/web/src/app/api/webhooks/stripe/README.md.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Price IDs for each purchasable entitlement tier (packages/db/src/schema/enums.ts's
# entitlement_tier). "free" has no price — it's the default, unpurchased tier.
# A tier with no price id configured simply isn't purchasable yet; nothing
# in this codebase fabricates one. monthly/annual are recurring Prices;
# lifetime must be configured in Stripe as a one-time Price (no recurring
# interval), since it's charged once via Checkout's "payment" mode.
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=
STRIPE_PRICE_ID_LIFETIME=

# =============================================================================
# SITE CONFIGURATION
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development