# TNSI Platform Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# =============================================================================
# CLERK AUTHENTICATION
# =============================================================================
# Get these from your Clerk Dashboard: https://dashboard.clerk.com
# Development instance: https://dashboard.clerk.com/apps (select dev instance)
# Production instance: https://dashboard.clerk.com/apps (select prod instance)

# Public key - safe to expose to client
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Secret key - NEVER expose to client, server-side only
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Webhook secret - used to verify Clerk webhook signatures
# Get this from Clerk Dashboard > Webhooks > Signing Secret
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Clerk URLs (customize if needed)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Optional: Custom Clerk API URL (default: https://api.clerk.com)
# CLERK_API_URL=https://api.clerk.com

# =============================================================================
# DATABASE (NEON POSTGRESQL)
# =============================================================================
# Get from Neon Console: https://console.neon.tech
# Format: postgresql://user:password@host/database?sslmode=require

# For local development with Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tnsi_dev?sslmode=disable

# For Neon (production/staging):
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/tnsi?sslmode=require

# Optional: Unpooled connection for migrations
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/tnsi?sslmode=require

# packages/db/drizzle.config.ts checks DATABASE_URL_UNPOOLED before
# DATABASE_URL for drizzle-kit commands (generate/migrate/push/studio) -
# intentional, since unpooled connections are the correct choice for DDL.
# To run those commands against an isolated/test database instead, set
# TNSI_TEST_DATABASE_URL inline for that command - it always wins over
# both of the above, since no local .env file ever sets it:
#   TNSI_TEST_DATABASE_URL="postgresql://..." pnpm --filter @tnsi/db db:migrate
# If the resolved URL points at production, drizzle-kit refuses to run
# unless ALLOW_PRODUCTION_DB_OPERATIONS=yes is also set explicitly for
# that command. See docs/TNSI_Somatic_Card_Migration_Incident.md.

# =============================================================================
# SANITY CMS
# =============================================================================
# Get from Sanity Dashboard: https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=hookrbdv
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Read token for private content/drafts (server-side only)
SANITY_API_READ_TOKEN=skri_your_read_token_here

# Webhook secret - used to verify Sanity practice-sync webhook signatures.
# Get this from Sanity Dashboard > API > Webhooks > (webhook) > Secret.
# Required for POST /api/webhooks/sanity — see apps/web/src/app/api/webhooks/sanity/README.md.
SANITY_WEBHOOK_SECRET=

# Separate secret for the Somatic Series/Card sync webhook - a distinct
# value from SANITY_WEBHOOK_SECRET above (register as its own webhook in
# Sanity, with its own Secret), not shared, so the two sync paths stay
# isolated from each other. Required for POST /api/webhooks/sanity-somatic
# — see apps/web/src/app/api/webhooks/sanity-somatic/README.md. Not yet
# registered in production as of this milestone.
SANITY_SOMATIC_WEBHOOK_SECRET=

# =============================================================================
# FLOWI (CRM — newsletter signup → lead)
# =============================================================================
# Server-side only. A GoHighLevel Private Integration token (or OAuth access
# token) scoped to the TNSI location, generated from within the Flowi/GHL
# account (Settings > Private Integrations, or a Marketplace app install).
# Required for POST /api/newsletter to reach Flowi — see packages/integrations/src/flowi.ts.
FLOWI_API_KEY=

# The Flowi/GHL location (sub-account) id the newsletter contact is created in.
FLOWI_LOCATION_ID=

# Secret the scheduler (Vercel Cron) sends as `Authorization: Bearer <value>` when
# it calls GET /api/internal/crm-outbox, which delivers queued Flowi events with
# retries. With it unset the route refuses to run (503). >= 32 random characters.
# Setting it on the project is what makes Vercel Cron send the header. The
# schedule is apps/web/vercel.json (daily on the Hobby plan; see
# docs/06-feature-specification.md, "CRM outbox").
CRON_SECRET=

# =============================================================================
# STRIPE PAYMENTS
# =============================================================================
# Get from Stripe Dashboard: https://dashboard.stripe.com
# Server-side only — checkout uses Stripe's hosted Checkout page, so no
# publishable key / Stripe.js is needed in the client bundle at all.
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# From Stripe Dashboard > Developers > Webhooks > (endpoint) > Signing secret.
# Required for POST /api/webhooks/stripe — see apps/web/src/app/api/webhooks/stripe/README.md.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Price IDs for each purchasable entitlement tier (packages/db/src/schema/enums.ts's
# entitlement_tier). "free" has no price — it's the default, unpurchased tier.
# A tier with no price id configured simply isn't purchasable yet; nothing
# in this codebase fabricates one.
#
# Regulation Suite(TM) approved model (Membership & Commercial Model v1) — two
# recurring GBP Prices are required:
#   STRIPE_PRICE_ID_MONTHLY  -> 5.99 per month
#   STRIPE_PRICE_ID_ANNUAL   -> 59 per year
# The 30-day free trial is NOT part of either Price and does not involve Stripe:
# it is app-managed (POST /api/v1/billing/trial), needs no card, and ends back on
# the Free account. Create plain recurring Prices with no trial.
# There is no Lifetime Price: Lifetime is closed to new purchases and no
# STRIPE_PRICE_ID_LIFETIME variable is read. Existing Lifetime members are
# preserved in the database and are never touched by Stripe sync.
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# Launch switch for Regulation Suite(TM) membership. Anything other than the
# exact value "true" keeps membership CLOSED: the website shows "not yet open
# for enrolment", no checkout is started, and NO practices/PowerDrops are
# locked. Even when "true", membership only opens if STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET and BOTH Price IDs above are set (a half-configured
# environment stays closed). Set it only after the launch checklist in
# docs/membership-commercial-decisions.md is complete; it is read when the
# site is built, so redeploy after changing it.
REGULATION_SUITE_MEMBERSHIP_OPEN=

# Optional: id of a RESTRICTED Stripe Billing Portal configuration (payment
# methods, cancellation, invoices, billing history; no plan switching, no
# products the app does not sell). Create it in the Stripe Dashboard, then set
# its id here. When unset, Stripe's default portal configuration is used, which
# must be checked in the Dashboard before membership opens.
STRIPE_PORTAL_CONFIGURATION_ID=

# Free-trial eligibility key (one trial per verified, normalised email). The
# trial endpoint stores only HMAC-SHA-256(secret, email) - never the address -
# and FAILS CLOSED (503, nothing written) if either value below is missing or
# malformed. Server-side only; read at request time. Never log or commit them.
#   TRIAL_ELIGIBILITY_SECRET        >= 32 chars from [A-Za-z0-9+/=_.-]
#                                   generate with: openssl rand -base64 48
#   TRIAL_ELIGIBILITY_KEY_VERSION   whole number 1-32767 (stored as key_version)
#   TRIAL_ELIGIBILITY_PREVIOUS_KEYS optional "version:secret,version:secret" for
#                                   still-active older versions
# ROTATION: add a version, never replace one. Put the new secret in
# TRIAL_ELIGIBILITY_SECRET with the next version number and move the old one
# into TRIAL_ELIGIBILITY_PREVIOUS_KEYS. Remove an old version ONLY when
# `SELECT count(*) FROM trial_claims WHERE key_version = <old>` is 0 (claims
# move to the current version when touched); dropping one with live claims, or
# losing the secret, makes those people eligible for a trial again.
# See packages/auth/src/trial/email.ts.
TRIAL_ELIGIBILITY_SECRET=
TRIAL_ELIGIBILITY_KEY_VERSION=
TRIAL_ELIGIBILITY_PREVIOUS_KEYS=

# =============================================================================
# SITE CONFIGURATION
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development