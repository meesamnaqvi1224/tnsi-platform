# Mobile environment variables. Every EXPO_PUBLIC_* value is compiled into
# the client bundle and is visible to anyone who inspects the app - treat
# all of these as public, never put a secret key here.
#
# Copy to .env.local (gitignored) and fill in real values before running
# `pnpm --filter @tnsi/mobile start`.

# Same Clerk instance as apps/web - this is the publishable key, safe to
# share client-side. Copy the value of NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
# from the web app's env.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of the Next.js API this app talks to. Point at a local dev
# server (e.g. http://192.168.1.x:3000 - not localhost, since a physical
# device/simulator can't reach the host machine's localhost) or a deployed
# environment.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
